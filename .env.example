# 复制为 .env 后修改（也可以直接在部署平台设置环境变量）
# 这些模型配置也可以登录管理员账号后在「站点管理」页面中修改，页面中的设置优先。

# —— 服务 ——
PORT=3000
# 数据目录（账号、项目、任务都保存在这里，请确保部署平台会持久化该目录）
DATA_DIR=./data
SITE_NAME=RTY Code

# —— 模型接口（OpenAI 兼容） ——
# 例如 https://api.openai.com/v1 、https://api.deepseek.com/v1 、
#      https://dashscope.aliyuncs.com/compatible-mode/v1
API_BASE_URL=
API_KEY=
# 多个模型用逗号分隔，第一个为默认模型
MODELS=
# DEFAULT_MODEL=

# —— 账号 ——
# 是否允许新用户自行注册（第一个注册的账号自动成为管理员）
ALLOW_REGISTER=true
# 可选：启动时自动创建管理员账号
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please

# —— 其他 ——
# 单次运行最多调用模型多少步
MAX_STEPS=30
# 接口不支持流式输出时设为 false
STREAM=true
